# Pick the default provider. Requests outside the server allowlist are rejected.
LLM_PROVIDER=glm

# Use the exact model ID shown in the provider console.
# For Kimi, do not guess this value; copy it from Moonshot/Kimi console docs.
LLM_MODEL=

# Optional per-provider override. If set, it wins over LLM_MODEL for that provider.
GLM_MODEL=
DEEPSEEK_MODEL=
KIMI_MODEL=

GLM_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Defaults are OpenAI-compatible endpoints and can be overridden when providers change them.
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_BASE_URL=https://api.moonshot.ai/v1

LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=900

# Providers that anonymous callers may use. Keep this narrow to control cost.
LLM_ALLOWED_PROVIDERS=glm

# Anonymous API controls. These are enforced on the server, never by the browser.
API_MAX_BODY_BYTES=12000
API_IP_PER_MINUTE=5
API_IP_PER_DAY=30
API_GLOBAL_PER_MINUTE=60
API_GLOBAL_PER_DAY=1000

# Set only when the deployment proxy overwrites this header.
# Cloudflare: cf-connecting-ip; hardened Nginx: x-real-ip.
# Leave empty for a conservative shared anonymous bucket.
TRUSTED_IP_HEADER=
